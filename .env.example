# Copy to .env and fill in. Never commit real values.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/vapi_analytics
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Server
PORT=5000
# Public base URL, used for links in verification emails (set this in production)
APP_URL=http://localhost:5000

# Demo mode: serve seeded sample calls to customers with no Vapi/Retell key.
# Seed with `npm run db:seed-demo`.
DEMO_MODE=false
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=demo-password-1

# Email verification. Without RESEND_API_KEY, verification emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Invoxa <no-reply@example.com>

# AI features (VoiceScope, Assistant Studio, report generation, chatbot)
OPENAI_API_KEY=

# Platform-level Vapi key used by Assistant Studio / VoiceScope routes (see README "Status")
VAPI_API_KEY=

# Facebook Ads integration (optional)
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v23.0

# JWT lifetime (default 24h)
# JWT_EXPIRES_IN=24h
